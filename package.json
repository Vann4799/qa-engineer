{
  "name": "qa-engineer",
  "version": "1.0.0",
  "description": "Installer for the qa-engineer agent skill: plan, write, execute and prove the whole QA lifecycle, then automate it and export the docs.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "qa-engineer": "cli/index.mjs"
  },
  "files": [
    "cli",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
